    {
        "id": "f_gate",
        "type": "function",
        "z": "stepper_tab_clean",
        "name": "Smart Gate Lock",
        "func": "var isRunning = context.get('isRunning') || false;\n\n// If an unlock signal arrives from the completion loop, clear the lock state\nif (msg.topic === \"reset_gate\") {\n    context.set('isRunning', false);\n    return null;\n}\n\n// If a button click arrives while the sequence is active, drop it\nif (isRunning) {\n    return null;\n}\n\n// Lock the gate and let the original command pass through\ncontext.set('isRunning', true);\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 290,
        "y": 140,
        "wires": [
            [
                "f_stat",
                "f_lock",
                "f_sw"
            ]
        ]
    },
